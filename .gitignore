# 用户运行时数据（含业务数据，勿提交）
data/

# 真实配置（含个人 token，勿提交；只提交 config.yaml.example）
# 用通配兜底：任何 config*.yaml 都不提交，唯独放行 .example
config*.yaml
config*.yml
!config.yaml.example

# 生成的驾驶舱网页含真实业务数据，勿提交
*驾驶舱*.html
cockpit_passwords.json
cockpit_*.html
!docs/usage-guide.html

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 采购流水线客户资料（公司抬头、BOM、库存导出、流程文件，均不得提交）
pipeline/out/
pipeline/boms/
pipeline/customer/
pipeline/rules.local.yaml
.venv-pipeline/

# 编辑器/系统
.DS_Store
.vscode/
.idea/

# WorkBuddy 本地元数据（含自动化 memory、项目 memory、口令与业务指标，绝不提交）
.workbuddy/

# 部署资料文件（含凭证，勿提交；只提交 .example）
deploy.yaml
deploy.*.yaml
!deploy.yaml.example
