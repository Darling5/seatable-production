# ============================================================
# 生产交付协同助手 — 配置文件（复制为 config.yaml 后填写）
# ============================================================
# 三种后端，开箱默认用 local（零配置、离线、不需要任何账号）
#   local    本地 CSV / Excel
#   seatable SeaTable（见下）
#   feishu   飞书多维表格（见下）
# ⚠️ backend 写了**未登记**的名字（如简道云/禅道，尚在路线图中）时：
#    默认只打印 [warn] 并**仍然退回 local**；写入路径（strict=True）会直接抛错 ——
#    这是有意的：静默退回 local 会把「写线上」变成「写本地 CSV」，而读回校验还会照样通过。
backend: local

# ── 本地模式（默认，零配置）──────────────────────────────
# 数据存成 CSV/Excel 文件，放在技能目录的 data/ 下，任何人都可直接用
local:
  data_dir: data          # 数据文件夹（相对本技能目录）；不存在会自动创建
  format: csv            # csv = 每表一个 .csv 文件；excel = 单个 .xlsx 多 sheet

# ── SeaTable 模式（可选）──────────────────────────────────
# 只有你想把数据存到自己的 SeaTable Base 时才填；留空则禁用
seatable:
  api_token: ""          # 兼容旧配置：默认 Base 的 API Token
  server: "https://cloud.seatable.cn"
  base_uuid: ""          # 兼容旧配置：默认 Base 的 dtable_uuid（不要写 access_token）
  # 多 Base 配置（推荐）：每个 Base 独立 token/UUID、认证会话与 metadata 缓存。
  # 真实凭证只填写本机 config.yaml（已被 .gitignore 排除），不要提交仓库。
  default_base: production
  bases:
    production:
      api_token: ""
      base_uuid: ""
      server: "https://cloud.seatable.cn"
    tasks:
      api_token: ""
      base_uuid: ""
      server: "https://cloud.seatable.cn"
    # crm Base（v1.9 起需要）：微信来单自动建线索/跟进记录走这里。
    # ⚠️ 不配置 crm 时，CRM 自动录入会退回 local 模式，业务数据可能写进本地 CSV！
    crm:
      api_token: ""
      base_uuid: ""
      server: "https://cloud.seatable.cn"
  # 未配置命名 Base 时，仍可只填上面的 api_token/base_uuid；空配置自动退回 local 模式
  # CLI 可用 --base production / --base tasks / --base crm 选择目标 Base。

# ── 飞书多维表格模式（可选）──────────────────────────────
# 两种取数方式，二选一即可；都不填则飞书后端不可用（会明确报错，不静默退回）。
#
#   ① cli（默认，推荐）—— 复用 lark-cli 的登录态，**不需要 app_secret**
#      前置：装好 lark-cli 并完成过一次 `lark-cli auth login`
#      （scope 需要 base:table:read / base:record:read / base:record:create
#        base:record:update / base:record:delete / base:table:create base:field:read）
#   ② api —— 直连 open.feishu.cn，需要企业自建应用的 app_id + app_secret，
#      适合分发给没装 lark-cli 的机器
#
# ⚠️ 飞书后端的能力边界（实测，别再当 bug 查）：
#   · 读**不是强一致**的：写入/删除成功之后立刻读回可能仍是旧值（实测 ~2.7s 才可见）。
#     上层的写后读回验证必须容忍这个窗口。
#   · 单向关联字段（bidirectional=false）无法实现双向 link()，适配器会显式拒绝。
#   · 单选/多选列的选项必须建列时给全，写不存在的选项直接报错（不会自动新增选项）。
feishu:
  # cli_path: ""          # 留空则自动查找（WorkBuddy 内置连接器包 → PATH → 常见安装位置）
  # identity: ""          # user / bot；留空跟随 lark-cli 的默认身份
  # transport: ""         # cli / api；留空则「有 app_id+app_secret 走 api，否则走 cli」
  # app_id: ""            # 应用级凭据，不是每个 Base 各填一份
  # app_secret: ""
  default_base: production
  bases:
    production:
      base_token: ""      # 兼容叫法：app_token / token / base 都会被识别
    tasks:
      base_token: ""
  # 只想快速验证连通性：python tools/verify_feishu.py --read-only
  # （只读，不写任何东西；加 --write-test 才会在 ZZ_WB_VERIFY_* 临时表上跑写路径并自动清理）

# ── 采购流水线库存源 ───────────────────────────────────────
# source: partdb | api | mcp | file
# PartDB 可由本工具 Docker 一键部署；已有 ERP 优先使用 api 或 mcp；file 是离线兜底。
inventory:
  source: file
  file:
    path: "pipeline/customer/inventory/库存导出.xlsx"
    # sheet: "库存"
    # header_row: 1
    # 通用“库存”列默认当作未确认库存；盘点确认后才设 true。
    stock_is_confirmed: false
    # 列名不同可在这里映射，例如：
    # columns:
    #   ipn: "物料编码"
    #   model: "物料名称"
    #   stock: "即时库存"
    #   location: "仓位"

  # 通用 REST/HTTP API。Token 建议用 ${ERP_TOKEN} 环境变量，不要明文提交。
  # api:
  #   base_url: "https://erp.example.com"
  #   list_path: "/api/inventory"
  #   method: GET
  #   auth: {type: bearer, token: "${ERP_TOKEN}"}
  #   data_path: "data.items"
  #   pagination: {type: page, page_param: page, size_param: pageSize, size: 100}
  #   # 金蝶等先登录再查库存时，可配置 login 获取会话 Token。
  #   login: {path: "/api/login", method: POST, body: {account: "${ERP_USER}", password: "${ERP_PASSWORD}"},
  #           token_path: "data.token", token_header: "Authorization", token_prefix: "Bearer"}
  #   fields: {ipn: "material.code", model: "material.name", stock: "quantity",
  #            location: "warehouse.name", unit_price: "price", supplier: "supplier.name"}
  #   stock_is_confirmed: false

  # MCP：调用客户已有库存工具。command、tool、arguments 都由客户本地配置。
  # mcp:
  #   command: "python customer/mcp_inventory_server.py"
  #   tool: "inventory.list"
  #   data_path: "items"
  #   fields: {ipn: "ipn", model: "name", stock: "stock", location: "location"}
  #   stock_is_confirmed: false

# 常见 ERP 预设只约定入口，不假设客户版本和字段；按现场 API 文档填写 api/mcp。
# kingdee: inventory.source=api，配置金蝶 WebAPI 地址、账套鉴权和字段映射。
# jiandaoyun: inventory.source=api，配置简道云 API/视图接口和字段映射。
# zentao: inventory.source=api 或 mcp，配置禅道库存/物料服务和字段映射。

# ── PartDB（可选库存源）──────────────────────────────
# 使用 PartDB 时把 inventory.source 改为 partdb，并填 URL/Token。
partdb:
  enabled: false
  url: ""                # 如 http://localhost:8080/api
  token: ""              # PartDB API Token

# ── 物料行情监控（可选）────────────────────────────
market:
  alert_threshold: 10        # 物料涨跌预警阈值（%），单个料号 vs 上次采购价/上次快照
  check_day: Monday          # 人工复查日（提示用）
  channels: [立创商城, 示例采购平台A商城, 原厂公告]
  currency: CNY              # 展示与折算币种，默认人民币 ¥
  # 自适应复查节奏：按「库存电子料数量」自动选间隔，省 API 配额。
  #   ≤100 种 → 每 7 天（每周） · 101~300 种 → 每 15 天（半月） · >300 种 → 每 30 天（每月）
  # 数量取 data/partdb_snapshot.json 的 part_count；写死数字（如 cadence: 7）则不自适应。
  cadence: auto
  # cadence_tiers: [[100, 7], [300, 15], [9999999, 30]]
  # 汇率兜底：联网取实时汇率失败时用（1 单位外币 = ? 人民币）
  # fx:
  #   static: {USD: 7.10, EUR: 7.80, HKD: 0.92}
  #
  # 代理商官方 API 凭证（**只读查价用**）。
  # ⚠️ 凭证属于你个人或你的团队，请自行去官网申请后填写，**不要提交到公开仓库**。
  #    本文件只给空占位符；真实值填进 config.yaml（已被 .gitignore 排除）。
  #    · 得捷 DigiKey：developer.digikey.com 注册应用 → 拿 Client ID / Secret
  #      （OAuth2 client_credentials，本项目自动取令牌并缓存，只调查询接口，不碰下单）
  #    · 贸泽 Mouser：mouser.com → My Account → APIs → 申请 Search API Key（UUID）
  #    配额参考：得捷约 1000 次/天，贸泽按账号；贸泽一次可查 10 个型号，代码已自动分批。
  api_keys:
    digikey:
      client_id: ""
      client_secret: ""
      api_version: v4        # v4=Product Information API（2026 起默认，App 订阅它）；
                             # v3=旧 Product Search API（App 订阅的若是 Search API 才用）
      sandbox: false         # true = 连沙盒（数据是假的，仅供联调）
      site: CN               # 站点：CN/US/HK…
      language: zh           # v4 自动映射 zhs（简体）；v3 用 zh
      currency: CNY          # 请求报价币种（默认人民币）
      ship_to: CN
    mouser:
      api_key: ""

# ── 原料行情监控（可选，零凭证）──────────────────────
# 跟上游原料成本：金/银/铜/锡/铝/镍 全自动，PP/LLDPE/PVC 作石化链代理指标，
# ABS/PC/PS 现货人工录入。**不需要任何 API key** —— 实时价走新浪期货公开接口。
# 命令统一入口：python market.py raw <fetch|show|trend|add|backfill|list>
commodities:
  alert_threshold: 3         # 原料波动预警阈值（%）。原料比单个料号活跃得多，
                             #   沿用物料的 10% 会漏报；实测塑料链一个月能走 15%，金属 3~8%。
  trend_days: 30             # 驾驶舱 / CLI 走势回看天数
  # 可选：给 spot 现货价加自动源（ABS/PC/PS 目前只能手工 add）。
  # 现货数据在生意社 / 卓创 / 中塑在线 / 同花顺 iFinD，均需付费授权；
  # 有授权后在这里填 endpoint，commodities.py 的 source 适配器位已预留，不用改结构。
  # spot_source: ifind
# 订阅判别（2026-09-02 实测）：App 状态 Approved ≠ 万事大吉。
# 得捷一个 App 可订阅多个 API 产品（Barcode/OrderStatus/ProductInformation V4/Quote/...），
# 代码调的端点必须在订阅列表里，否则 401 "You are not subscribed to this API"。
# V4 keyword 端点信息最全（价+库存+生命周期中文），productdetails 不返回真实库存，勿用。

# ── 微信情报（可选）────────────────────────────────
# 引擎A（微信4.x，推荐）：保持微信PC版登录，直接只读本地加密库，无需任何工具。
#   依赖：pip install cryptography
# 引擎B（微信3.x回退）：用 win-wechat-summary 生成的 merge_all.db。
wechat:
  enabled: true
  db_dir: ""             # 引擎A：微信数据根目录（含 wxid_xxx 子目录），留空=自动探测
  db_path: ""            # 引擎B：merge_all.db 绝对路径，留空=自动搜索
  watch_groups: []       # 要监控的群名/群ID列表；留空=所有群（群多时首拉很慢）
  max_hours: 48          # 首次拉取回看时长（小时）
  # 群消息核对（wx/wxmatch.py）要往哪个 SeaTable Base 写。留空即可，绝大多数情况不用填：
  #   解析链 = ① `seatable.bases` 里的 `business` → ② 这里的 `wx.business_base` 指定的 Base 名
  #            → ③ `seatable.default_base`（出厂默认，本机是 production）
  # 只有在「群消息写库单独占一个 Base」的部署形态下才需要填第 ② 步。
  # ⚠️ 写路径不许静默降级：backend=seatable 却解析不出任何可用 Base 时会**直接抛错**
  #    （记成 blocked），绝不退回 local —— 否则「写线上」会变成「写本地 CSV」且读回照样通过。
  business_base: ""
  # 发言人别名映射（wxid/微信号 -> 显示名）。优先级最高：同一人多个账号/多个昵称
  # （如企微号显示真名、个人小号是另一个昵称）时，统一聚合到一个名字下。
  # 示例（请换成你自己的）：
  # sender_aliases:
  #   demo_account: 示例员工

# ── 你公司的默认值（可选，但建议填）──────────────────────
# 供应商 / 贴片厂 / 组装厂每家公司都不一样，代码里不写死。
# 这里填了，录入时就自动带上；不填就每次问你（或从历史记录里选）。
# defaults:
#   外壳采购记录:
#     供应商: 你常用的外壳厂
#   PCBA半成品采购记录:
#     供应商: 你常用的 PCBA 厂
#   组装记录:
#     组装厂: 你常用的组装厂

# ── 你公司的业务主体名（可选；建议填，否则群审计/核对会退化）────
# 这些是**真实业务身份**（本公司品牌、客户简称、供应商别名、已排除的群），
# 刻意不写进代码——写进去就等于随仓库公开你的供应链与客户名单。
# 填到这里（config.yaml 已被 .gitignore 排除），
# tools/audit_wx_coverage.py 与 wx/wxmatch.py 会自动读取、覆盖代码里的泛化示例。
# entities:
#   own_company: [你的公司名, 你的品牌, 关联主体]     # 合同/群名里出现即为「我方」
#   self_brand: [你的品牌]                            # 群名里的「我们」
#   self_kw: [你家内部群关键词]                        # 例：XX生产、XX品宣、工厂生产
#   supplier_aliases: {合同里的写法: 表里的写法}        # 一字之差/简称
#   cust_alias: {项目表客户名: [群名里可能出现的写法]}   # 客户群匹配
#   alias: {公司全称: 规范简称}
#   product_alias: {供应商简称: [它供的料件词]}         # 群名按料件命名时兜底
#   product_deny: {供应商简称: [排除词]}
#   excluded_groups_exact: {群名: 排除理由}            # 永久不纳入监控（全名精确）
#   excluded_groups_substr: {子串: 排除理由}           # 永久不纳入监控（子串）
